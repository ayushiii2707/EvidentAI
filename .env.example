# Copy to .env and change for anything beyond local development.
EVIDENTAI_OWNER_PASSWORD=owner_dev_only
EVIDENTAI_APP_PASSWORD=app_dev_only

# Owner role: migrations only.
EVIDENTAI_DATABASE_URL=postgresql+psycopg://evidentai_owner:owner_dev_only@127.0.0.1:5433/evidentai
# Application role: API and workers. Subject to row-level security.
EVIDENTAI_APP_DATABASE_URL=postgresql+psycopg://evidentai_app:app_dev_only@127.0.0.1:5433/evidentai
# Disposable test database (must end in _test; tests drop and recreate it).
EVIDENTAI_TEST_DATABASE_URL=postgresql+psycopg://evidentai_owner:owner_dev_only@127.0.0.1:5433/evidentai_test
